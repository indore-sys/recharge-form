# Client Requirements Form
RewriteEngine On

# Redirect root to client form
RewriteRule ^$ client-requirement-form.html [L]

# DirectoryIndex
DirectoryIndex client-requirement-form.html index.php

# Allow all files
<Files "*">
    Require all granted
</Files>

# PHP settings
<IfModule mod_php.c>
    php_flag display_errors On
    php_value max_execution_time 300
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
</IfModule>

# Error handling
ErrorDocument 404 /404.html